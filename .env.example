# Signaling server URL for y-webrtc (local dev default)
VITE_SIGNALING_URL=ws://localhost:4444

# STUN/TURN servers for WebRTC NAT traversal
VITE_STUN_SERVERS=stun:stun.l.google.com:19302

# WebLLM model cache path (OPFS relative)
VITE_MODEL_CACHE_PATH=/models

# Max VRAM to allocate for WebLLM (in MB, 0 = auto-detect)
VITE_MAX_VRAM_MB=0

# Optional CORS proxy used by the Bridge scraper after direct browser fetches fail
VITE_CORS_PROXY_URL=

# Debug logging
VITE_DEBUG=false
